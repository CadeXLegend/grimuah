# pre-commit for the grimuah generator repo itself
# the source is zig, so the pnpm gates a scaffolded project runs do not all apply
# here: the gates are the zig build, the unit tests, and the e2e suite that
# validates the generated projects end to end
#
# husky runs this file with `sh -e`, so the first failing gate stops the commit
# RULES.md is kept in step with the rule table here: the counts it states are
# derived and rewritten, then the hand-written rows are gated against the rules
# the engine actually ships, and the hook is what re-stages the rewritten lines
bash ./rule-docs.sh
git add -- RULES.md README.md

zig build
zig build test
bash test-e2e.sh
bash .husky/check-em-dash.sh

# `src/templates/` is the exception to the zig-only rule, because those files are
# the TypeScript every scaffolded project is handed: the compiler reads them here
# rather than only in a project that was generated from them
pnpm typecheck
