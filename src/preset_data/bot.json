{
  "sourceRoots": ["lib", "src"],
  "surfaces": [
    {
      "name": "lib",
      "path": "lib",
      "depth": 0,
      "dagOrder": 0,
      "suffixes": [".ts"],
      "innateMembers": [".types.ts", ".config.ts", ".spec.ts"],
      "allowedImports": []
    },
    {
      "name": "db",
      "path": "src/db",
      "depth": 1,
      "dagOrder": 1,
      "suffixes": [".repo.ts"],
      "innateMembers": [".types.ts", ".config.ts", ".spec.ts", "schema.ts"],
      "allowedImports": []
    },
    {
      "name": "services",
      "path": "src/services",
      "depth": 1,
      "dagOrder": 2,
      "suffixes": [".service.ts"],
      "innateMembers": [".types.ts", ".config.ts", ".spec.ts"],
      "allowedImports": []
    },
    {
      "name": "middleware",
      "path": "src/middleware",
      "depth": 1,
      "dagOrder": 3,
      "suffixes": [".middleware.ts"],
      "innateMembers": [
        ".types.ts",
        ".config.ts",
        ".spec.ts",
        ".regex-patterns.ts"
      ],
      "allowedImports": []
    },
    {
      "name": "components",
      "path": "src/components",
      "depth": 1,
      "dagOrder": 4,
      "suffixes": [".component.ts"],
      "innateMembers": [".types.ts", ".config.ts", ".spec.ts"],
      "allowedImports": []
    },
    {
      "name": "commands",
      "path": "src/commands",
      "depth": 1,
      "dagOrder": 5,
      "suffixes": [".command.ts", ".commands.ts", ".callbacks.ts"],
      "innateMembers": [
        ".types.ts",
        ".config.ts",
        ".spec.ts",
        ".regex-patterns.ts"
      ],
      "allowedImports": []
    },
    {
      "name": "tasks",
      "path": "src/tasks",
      "depth": 1,
      "dagOrder": 6,
      "suffixes": [".task.ts"],
      "innateMembers": [".types.ts", ".config.ts", ".spec.ts"],
      "allowedImports": []
    },
    {
      "name": "handlers",
      "path": "src/handlers",
      "depth": 1,
      "dagOrder": 7,
      "suffixes": [".handler.ts"],
      "innateMembers": [".types.ts", ".config.ts", ".spec.ts"],
      "allowedImports": []
    }
  ],
  "layers": {
    "cosmetic": true,
    "structural": true,
    "resilience": true,
    "behavioural": true
  },
  "rootLib": {
    "enabled": true,
    "path": "lib"
  }
}
