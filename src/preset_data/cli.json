{
  "surfaces": [
    {
      "name": "lib",
      "path": "lib",
      "depth": 0,
      "dagOrder": 0,
      "suffixes": [".ts"],
      "innateMembers": [".types.ts", ".config.ts", ".spec.ts"],
      "allowedImports": []
    },
    {
      "name": "utils",
      "path": "src/utils",
      "depth": 1,
      "dagOrder": 1,
      "suffixes": [".util.ts"],
      "innateMembers": [
        ".types.ts",
        ".config.ts",
        ".spec.ts",
        ".regex-patterns.ts"
      ],
      "allowedImports": ["lib"]
    },
    {
      "name": "services",
      "path": "src/services",
      "depth": 1,
      "dagOrder": 2,
      "suffixes": [".service.ts"],
      "innateMembers": [".types.ts", ".config.ts", ".spec.ts"],
      "allowedImports": ["lib", "utils"]
    },
    {
      "name": "commands",
      "path": "src/commands",
      "depth": 1,
      "dagOrder": 3,
      "suffixes": [".command.ts"],
      "innateMembers": [
        ".types.ts",
        ".config.ts",
        ".spec.ts",
        ".regex-patterns.ts"
      ],
      "allowedImports": ["lib", "utils", "services"]
    }
  ],
  "layers": {
    "cosmetic": true,
    "structural": true,
    "resilience": true,
    "behavioural": true
  },
  "rootLib": {
    "enabled": true,
    "path": "lib"
  }
}
